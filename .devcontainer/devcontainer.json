// =============================================================================
// DevContainer Configuration: CPU Mode (Production/Development)
// =============================================================================
// Use this configuration for development without GPU or production deployment.
// To activate: bash scripts/select-devcontainer-mode.sh cpu  (OUTSIDE container)
// Then rebuild the container in VS Code.
// =============================================================================
{
  "name": "ProjectXII CV - CPU Only",
  
  // Use Microsoft's Python image (no CUDA needed)
  "image": "mcr.microsoft.com/devcontainers/python:2-3.11-trixie",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-vscode.makefile-tools",
        "eeyore.indent-rainbow",
        "GitHub.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-python.python"
        }
      }
    }
  },
  
  // Add ~/.local/bin to PATH for user-installed scripts (black, pytest, etc.)
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },
  
  // Install Python dependencies from pinned requirement files
  "postCreateCommand": "pip3 install --user -r requirements.txt && pip3 install --user -r requirements-dev.txt",
  
  // Port forwarding for development servers
  "forwardPorts": [8000, 3000, 5173, 6006],
  "portsAttributes": {
    "8000": {"label": "FastAPI", "onAutoForward": "notify"},
    "3000": {"label": "React Dev", "onAutoForward": "notify"},
    "5173": {"label": "Vite Dev", "onAutoForward": "notify"},
    "6006": {"label": "TensorBoard", "onAutoForward": "notify"}
  }
}
