// =============================================================================
// DevContainer Configuration: NVIDIA GPU Mode (Training)
// =============================================================================
// Use this configuration when training YOLO models locally with NVIDIA GPU.
// To activate: bash scripts/select-devcontainer-mode.sh nvidia-gpu  (OUTSIDE container)
// Then rebuild the container in VS Code.
// =============================================================================
{
  "name": "ProjectXII CV - NVIDIA GPU",
  
  // Use NVIDIA CUDA image directly (no Dockerfile needed)
  "image": "nvidia/cuda:12.1.0-runtime-ubuntu22.04",
  
  // GPU configuration - requires NVIDIA Container Toolkit
  "runArgs": [
    "--gpus", "all",
    "--shm-size=8gb"
  ],
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10"
    }
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-vscode.makefile-tools",
        "eeyore.indent-rainbow",
        "GitHub.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-python.python"
        }
      }
    }
  },
  
  // Add ~/.local/bin to PATH for user-installed scripts (black, pytest, etc.)
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },
  
  // Install CUDA-enabled PyTorch, then other dependencies
  "postCreateCommand": "pip3 install --user torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu121 && pip3 install --user -r requirements.txt && pip3 install --user -r requirements-dev.txt",
  
  // Port forwarding for development servers
  "forwardPorts": [8000, 3000, 5173, 6006],
  "portsAttributes": {
    "8000": {"label": "FastAPI", "onAutoForward": "notify"},
    "3000": {"label": "React Dev", "onAutoForward": "notify"},
    "5173": {"label": "Vite Dev", "onAutoForward": "notify"},
    "6006": {"label": "TensorBoard", "onAutoForward": "notify"}
  }
}
