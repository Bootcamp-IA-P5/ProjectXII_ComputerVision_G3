# =============================================================================
# Model Inference Settings
# =============================================================================
YOLO_MODEL_TYPE=yolov11x
# YOLO_MODEL_TYPE=yolov8x

# Detection confidence threshold (0.0-1.0): skip detections below this
CONFIDENCE_THRESHOLD=0.25
# IOU threshold for Non-Maximum Suppression (0.0-1.0): lower = more detections
IOU_THRESHOLD=0.45
# Device: 'auto' (GPU if available), 'cuda' (force GPU), 'cpu' (force CPU)
DEVICE=auto

# =============================================================================
# API Server
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/postgres

# =============================================================================
# Storage Directories
# =============================================================================
# Note: Storage directories (e.g., for uploaded videos and extracted crops)
# are derived from the application's DATA_DIR setting in config.py and are
# not configurable via environment variables.

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Roboflow Workflows Configuration
# =============================================================================
# Get from: https://app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=your_api_key_here
ROBOFLOW_WORKSPACE=F5_Computer_Vision_Project
ROBOFLOW_WORKFLOW_ID=Custom Workflow
# Slack (Optional)
SLACK_WEBHOOK_URL=

# =============================================================================
# Supabase (Optional - for cloud storage)
# =============================================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_CROPS=

# =============================================================================
# Celery & Redis (Async Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1