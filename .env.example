# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values

# Model Inference Settings
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DEVICE=auto

# Database (Supabase PostgreSQL)
# Get your connection string from: Supabase Dashboard → Settings → Database → Connection string → URI
# IMPORTANT: Use port 6543 (pooler) for connection pooling, or 5432 for direct connection
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Logging
LOG_LEVEL=INFO

# =============================================================================
# Roboflow Workflows Configuration (Optional)
# =============================================================================
# Get your API key from: https://app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=your_api_key_here
ROBOFLOW_WORKSPACE=your_workspace
ROBOFLOW_WORKFLOW_ID=your_workflow_id

# Optional: Slack webhook for notifications
SLACK_WEBHOOK_URL=
